    },
    {
      "label": "to someone who worked for you",
      "arabic": "عاشَت إيدَك",
      "transliteration": "3aashat eedak",
      "english": "long live your hand",
      "note": "Said after a meal, a favour or a job well done."
    },
    {
      "label": "strong",
      "arabic": "مَمنون",
      "transliteration": "mamnoon",
      "english": "grateful",
      "note": "A slightly more formal \"I'm grateful\"."
    }
  ],
  "responses": [
    {
