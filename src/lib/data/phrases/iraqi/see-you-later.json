      "note": "\"Baachir\" is the Iraqi \"tomorrow\"."
    },
    {
      "label": "to a woman",
      "arabic": "أشوفِك بَعدين",
      "transliteration": "ashoofich ba3dain",
      "english": "see you later (f)",
      "note": "The feminine form."
    }
  ],
  "responses": [
    {
      "arabic": "إن شاء الله",
      "transliteration": "in shaa2 alla",
      "english": "God willing"
    },
    {
      "arabic": "الله وياك",
      "transliteration": "alla wiyyaak",
      "english": "God be with you"
    }
  ],
  "examples": [
