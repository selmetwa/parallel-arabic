{
  "slug": "see-you-later",
  "dialect": "khaleeji",
  "english": "see you later",
  "arabic": "أشوفَك بَعدين",
  "arabicPlain": "أشوفك بعدين",
  "transliteration": "ashoofak ba3dain",
  "franco": "ashoofak ba3dain",
  "literal": "I see you later",
  "usage": "To a man \"ashoofak\", to a woman \"ashoofich\". Often with \"in shaa2 alla\".",
  "variants": [
    {
      "label": "tomorrow",
      "arabic": "أشوفَك باكِر",
      "transliteration": "ashoofak baachir",
      "english": "see you tomorrow",
      "note": "\"Baachir\" is the Gulf \"tomorrow\"."
    },
    {
      "label": "to a woman",
      "arabic": "أشوفِك بَعدين",
      "transliteration": "ashoofich ba3dain",
      "english": "see you later (f)",
      "note": "The feminine form."
    }
  ],
  "responses": [
    {
      "arabic": "إن شاء الله",
      "transliteration": "in shaa2 alla",
      "english": "God willing"
    },
    {
      "arabic": "في أمان الله",
      "transliteration": "fi amaan alla",
      "english": "in God's safekeeping"
    }
  ],
  "examples": [
    {
      "arabic": "يَلّا، أشوفَك بَعدين",
      "transliteration": "yalla, ashoofak ba3dain",
      "english": "OK, see you later"
    },
    {
      "arabic": "أشوفَك باكِر في الدَّوام",
      "transliteration": "ashoofak baachir fid-dawaam",
      "english": "See you tomorrow at work"
    },
    {
      "arabic": "مَعَ السَّلامة، أشوفكُم في العيد",
      "transliteration": "ma3a is-salaama, ashoofkum fil-3eed",
      "english": "Bye, see you all at Eid"
    }
  ]
}
