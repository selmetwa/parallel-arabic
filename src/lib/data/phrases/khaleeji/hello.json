  "franco": "hala",
  "literal": "welcome",
  "usage": "The everyday Gulf hello, warm and fine for anyone. Greetings in the Gulf are long: after \"hala\" come questions about health, family and news, often repeated.",
  "variants": [
    {
      "label": "formal / traditional",
      "arabic": "السَّلامُ عَلَيكُم",
      "transliteration": "is-salaamu 3alaikum",
      "english": "peace be upon you",
      "note": "The standard greeting when entering a majlis, a shop or an office; always answered with \"w-3alaikum is-salaam\"."
    },
    {
      "label": "extra warm",
      "arabic": "هَلا والله",
      "transliteration": "hala walla",
      "english": "welcome, by God",
      "note": "Very common and warm, especially when meeting a friend."
    },
    {
      "label": "casual",
      "arabic": "هايّ",
      "transliteration": "haay",
      "english": "hi",
      "note": "Borrowed from English, common among young people in Dubai and Kuwait."
    }
  ],
  "responses": [
    {
      "arabic": "هَلا فيك",
      "transliteration": "hala feek",
      "english": "welcome to you"
    },
    {
      "arabic": "هَلا والله، حَيّاك",
      "transliteration": "hala walla, 7ayyaak",
      "english": "welcome, God greet you"
    }
  ],
  "examples": [
    {
      "arabic": "هَلا، شلونَك اليوم؟",
      "transliteration": "hala, shloonak il-yoom?",
      "english": "Hello, how are you today?"
    },
    {
      "arabic": "هَلا والله، شو الأخبار؟",
      "transliteration": "hala walla, shu il-akhbaar?",
      "english": "Hello, what's new?"
    },
    {
      "arabic": "هَلا، أحمد موجود؟",
      "transliteration": "hala, a7mad mawjood?",
      "english": "Hello, is Ahmed here?"
    }
  ]
